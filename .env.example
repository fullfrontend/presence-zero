# PresenceZero environment variables
#
# Application settings saved in Settings override these environment defaults.
# Use environment / default in Settings to restore inheritance. Settings changes
# apply to the next scan step without restart. Database, ports, APIFY_MAX_PLACES
# and AI_PROMPTS_DIR remain deployment-only.
#
# EVERY variable here is OPTIONAL. With nothing set, PresenceZero runs locally
# against a SQLite file and works out of the box with the OpenStreetMap and CSV
# providers (no API key needed). Copy this file to `.env` and edit as needed:
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------

# Database. Defaults to a local SQLite file if unset.
#   - Local / Docker: leave as-is (a file next to the app).
#   - Vercel / hosted: use your Turso libSQL URL instead, e.g.
#       DATABASE_URL=libsql://your-db-name.turso.io
DATABASE_URL=file:presencezero.db

# Auth token for a hosted libSQL/Turso database. ONLY needed for Turso/Vercel,
# not for a local file database. Get it when you create the Turso database.
# DATABASE_AUTH_TOKEN=

# Google Places (New) API key. ONLY needed if you use the Google provider;
# the OpenStreetMap and CSV providers need no key.
# Get one (free tier): https://console.cloud.google.com
#   → create a project → enable "Places API (New)" → APIs & Services → Credentials
#   → Create credentials → API key.
# You can also paste this key into the app's Settings page instead of setting it here.
# GOOGLE_PLACES_API_KEY=

# Advanced: maximum new background tasks started per scheduling cycle (every second).
# Settings can override this and the concurrency limits below.
# PRESENCEZERO_BATCH_SIZE=8
# Concurrent tasks across scans sharing the database (1–16 per stage).
# PRESENCEZERO_CONCURRENCY_COLLECT=1
# PRESENCEZERO_CONCURRENCY_SEARCH=1
# PRESENCEZERO_CONCURRENCY_PROBE=4
# PRESENCEZERO_CONCURRENCY_DOMAINS=2
# PRESENCEZERO_CONCURRENCY_PHONE=2
# PRESENCEZERO_CONCURRENCY_AUDIT=1
# Start the durable worker in this Node/Docker server (restart required).
# Disable only when another persistent server handles the same database.
# PRESENCEZERO_WORKER_ENABLED=true

# Apify API token. ONLY needed if you use the Apify (Google Maps) provider.
# Free plan: $5 of credit renewed monthly (~1,250 places), no credit card.
# Get it at https://console.apify.com → Settings → API & Integrations.
# You can also paste this token into the app's Settings page instead.
# APIFY_TOKEN=

# Advanced: raise the per-scan place ceiling (default 100). Each place costs
# ~$0.004 on Apify's free tier, so raising this raises your spend.
# APIFY_MAX_PLACES=100

# Optional website discovery for all sources (one Brave search per missing site).
# Explicit opt-in required: a key alone never enables discovery.
# Set to true and restart the app; completed scans must be rerun.
BRAVE_SEARCH_ENABLED=false
# Uses your account: set a spending limit in Brave to stay within free credits.
# A key saved in Settings takes precedence over this environment value.
BRAVE_SEARCH_API_KEY=

# Optional free, self-hosted website discovery. Takes priority over Brave;
# a SearXNG failure never triggers a paid fallback.
# Explicit opt-in required even in Docker: a URL alone never enables search.
SEARXNG_ENABLED=false
# For `npm run dev` + `npm run docker:search`:
# SEARXNG_URL=http://127.0.0.1:8080
# Full Docker Compose sets http://searxng:8080 automatically.
# Shared spacing between requests, across scans (milliseconds; default 5 seconds).
SEARXNG_MIN_INTERVAL_MS=5000
# Minimum wait after CAPTCHA/rate limiting (default 5 minutes), then retry once.
# A longer Retry-After from the service takes precedence. Persistent blocks pause
# the scan with its progress saved. Long waits require a long-running app server.
SEARXNG_COOLDOWN_MS=300000


# Initial location for new scans. Read at runtime (also works in Docker).
# Original defaults: blank location and US country code.
# Users can still edit these fields or reuse a previous scan in the form.
PRESENCEZERO_DEFAULT_LOCATION=""
PRESENCEZERO_DEFAULT_COUNTRY_CODE=us

# Local AI lead summaries and evidence-based website audits (optional, no cloud fallback).
# Default global opt-in for ALL AI (overridable in Settings): light/heavy models, evidence preparation, lead summaries
# and website audits. Only true enables AI; false or unset disables all AI calls
# and AI-specific crawling/profile loading, even when models are configured.
# Restart the app (or recreate its container) after changing this flag.
# Install/pull local Ollama models yourself, then enable and select their exact names.
AI_AUDIT_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Website-audit model (heavy role): ollama pull qwen3.5:9b-q4_K_M
OLLAMA_MODEL=qwen3.5:9b-q4_K_M
# For PresenceZero in Docker + Ollama on the host, use:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# Set OLLAMA_NO_CLOUD=1 on the Ollama SERVER (not only in this app's .env).
# Long-running local/Docker app required; one business per scan step by default when enabled.
OLLAMA_LIGHT_MODEL=qwen3.5:4b-q4_K_M
# Light role: exact evidence selection and listing-only summaries.
AI_AUDIT_PREPARE_EVIDENCE=true
OLLAMA_LIGHT_TIMEOUT_MS=60000
OLLAMA_LIGHT_NUM_CTX=16384
OLLAMA_LIGHT_NUM_PREDICT=2000
# Disable thinking for bounded JSON tasks. Enable only for supported models;
# increase output-token/time budgets if enabling it. Light and heavy are separate.
OLLAMA_LIGHT_THINK=false
OLLAMA_THINK=false
OLLAMA_TIMEOUT_MS=180000
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=2500
OLLAMA_KEEP_ALIVE=5m
# Language of generated reports; does not translate the application interface.
AI_AUDIT_LANGUAGE=fr
# At most 1–5 HTML pages per business, respecting robots.txt and same-origin links.
AI_AUDIT_MAX_PAGES=3
AI_AUDIT_PAGE_TIMEOUT_MS=10000
AI_AUDIT_MAX_PAGE_BYTES=200000
AI_AUDIT_MAX_PAGE_CHARS=6000
AI_AUDIT_PAGE_DELAY_MS=1000
# Separate from the existing lead score: opportunity = 100 - estimated site quality.
AI_AUDIT_OPPORTUNITY_THRESHOLD=60
# Optional qualification filters, applied to audits only (no businesses deleted).
AI_AUDIT_MIN_RATING=0
AI_AUDIT_MIN_REVIEWS=0
AI_AUDIT_MAX_REVIEWS=1000000
AI_AUDIT_EXCLUDE_ECOMMERCE=false
AI_AUDIT_EXCLUDE_CHAINS=false
# Uses an explicit establishment-year claim on the website, never domain age.
# Unknown age passes; zero disables the filter. Chain/ecommerce signals are heuristics.
AI_AUDIT_MIN_BUSINESS_AGE_YEARS=0

# Declarative prompt profiles (no executable code). Generic example lives in:
# examples/ai-prompts/default.json
# Keep your real profiles OUTSIDE this repo; they are never copied into Docker images.
# AI_PROMPTS_DIR=/absolute/path/outside/project/presencezero-prompts
AI_PROMPT_PROFILE=default
# Loader reads <AI_PROMPTS_DIR>/<AI_PROMPT_PROFILE>.json, max 32 KiB, schema version 1.
# With no directory and profile=default, the generic bundled example is used.

# Interface locale fallback when no language cookie or supported browser preference exists.
# Supported values: fr-FR, en-US. The language selector stores a per-browser preference.
# This is independent of AI_AUDIT_LANGUAGE (language of newly generated reports).
PRESENCEZERO_DEFAULT_LOCALE=en-US
